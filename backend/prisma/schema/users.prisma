model User {
  id                 String                @id @default(uuid())
  name               String
  email              String                @unique
  phoneNumber        String?               @map("phone_number")
  dateOfBirth        DateTime?             @map("date_of_birth") @db.Date
  location           String?
  occupation         String?
  photoUrl           String?               @map("photo_url")
  latitude           Float?
  longitude          Float?
  passwordHash       String                @map("password_hash")
  otpVerified        Boolean               @default(false) @map("otp_verified")
  createdAt          DateTime              @default(now()) @map("created_at")
  adoptions          Adoption[]
  animalsPosted      Animal[]              @relation("UserPostedAnimals")
  campaignsJoined    CampaignParticipant[]
  campaignsOrganized Campaign[]            @relation("UserOrganizedCampaigns")
  complaints         Complaint[]
  contributions      Contributor[]
  donations          Donation[]
  ngoReviews         NgoReview[]
  rescueRequests     RescueRequest[]
  testimonials       Testimonial[]

  @@map("users")
}

model Ngo {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  phoneNumber          String?         @map("phone_number")
  registrationNumber   String?         @unique @map("registration_number")
  location             String?
  latitude             Float?
  longitude            Float?
  areaOfWork           String?         @map("area_of_work")
  description          String?
  photoUrl             String?         @map("photo_url")
  passwordHash         String          @map("password_hash")
  otpVerified          Boolean         @default(false) @map("otp_verified")
  verified             Boolean         @default(false)
  createdAt            DateTime        @default(now()) @map("created_at")
  achievements         String?
  workDone             String?         @map("work_done")
  certificateUrl       String?         @map("certificate_url")
  upiId                String?         @map("upi_id")
  websiteUrl           String?         @map("website_url")
  adoptions            Adoption[]
  animalsPosted        Animal[]        @relation("NgoPostedAnimals")
  campaignsOrganized   Campaign[]      @relation("NgoOrganizedCampaigns")
  contributors         Contributor[]
  donationsMade        Donation[]      @relation("NgoMadeDonations")
  donationsReceived    Donation[]      @relation("NgoReceivedDonations")
  posts                NgoPost[]
  reviews              NgoReview[]
  rescueRequestsNearby RescueRequest[]

  @@map("ngos")
}
