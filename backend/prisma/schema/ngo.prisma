// ─── NGO CONTENT ────────────────────────────────────────────

model NgoPost {
  id          String    @id @default(uuid())
  ngoId       String    @map("ngo_id")
  postType    PostType? @map("post_type")
  title       String
  description String?
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at")

  ngo Ngo @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@map("ngo_posts")
}

model Contributor {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  ngoId            String           @map("ngo_id")
  contributionType ContributionType? @map("contribution_type")
  location         String?
  createdAt        DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngo  Ngo  @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@unique([userId, ngoId]) // ADDED: one contribution record per user-ngo pair
  @@map("contributors")
}

model NgoReview {
  id        String   @id @default(uuid())
  ngoId     String   @map("ngo_id")
  userId    String   @map("user_id")
  content   String
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")

  ngo  Ngo  @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ngo_reviews")
}
