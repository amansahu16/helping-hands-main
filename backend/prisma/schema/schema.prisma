generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phoneNumber  String   @map("phone_number")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Animal {
  id             String       @id @default(uuid())
  postedByUserId String?      @map("posted_by_user_id")
  postedByNgoId  String?      @map("posted_by_ngo_id")
  name           String?
  category       String?
  age            String?
  location       String?
  latitude       Float?
  longitude      Float?
  description    String?
  photos         String[]     @default([])
  status         AnimalStatus @default(AVAILABLE)
  createdAt      DateTime     @default(now()) @map("created_at")
  adoptions      Adoption[]
  postedByNgo    Ngo?         @relation("NgoPostedAnimals", fields: [postedByNgoId], references: [id])
  postedByUser   User?        @relation("UserPostedAnimals", fields: [postedByUserId], references: [id])

  @@map("animals")
}

model Adoption {
  id        String         @id @default(uuid())
  animalId  String         @map("animal_id")
  adopterId String?        @map("adopter_id")
  ngoId     String?        @map("ngo_id")
  status    AdoptionStatus @default(IN_PROGRESS)
  createdAt DateTime       @default(now()) @map("created_at")
  adoptedAt DateTime?      @map("adopted_at")
  adopter   User?          @relation(fields: [adopterId], references: [id])
  animal    Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  ngo       Ngo?           @relation(fields: [ngoId], references: [id])

  @@map("adoptions")
}

model RescueRequest {
  id             String       @id @default(uuid())
  reporterId     String?      @map("reporter_id")
  reporterNgoId  String?      @map("reporter_ngo_id")
  nearbyCenterId String?      @map("nearby_center_id")
  animalType     String?      @map("animal_type")
  location       String?
  latitude       Float?
  longitude      Float?
  description    String?
  condition      String?
  photos         String[]     @default([])
  nearbyHospital String?      @map("nearby_hospital")
  status         RescueStatus @default(OPEN)
  createdAt      DateTime     @default(now()) @map("created_at")
  nearbyCenter   Ngo?         @relation(fields: [nearbyCenterId], references: [id])
  reporter       User?        @relation(fields: [reporterId], references: [id])
  reporterNgo    Ngo?         @relation("NgoReportedRescues", fields: [reporterNgoId], references: [id])

  @@map("rescue_requests")
}

model Campaign {
  id                  String                @id @default(uuid())
  organizerUserId     String?               @map("organizer_user_id")
  organizerNgoId      String?               @map("organizer_ngo_id")
  name                String
  description         String?
  location            String?
  timeFrom            DateTime?             @map("time_from")
  timeTo              DateTime?             @map("time_to")
  maxParticipants     Int?                  @map("max_participants")
  currentParticipants Int                   @default(0) @map("current_participants")
  status              CampaignStatus        @default(PLANNED)
  createdAt           DateTime              @default(now()) @map("created_at")
  type                String?               @default("OTHER")
  latitude            Float?
  longitude           Float?
  participants        CampaignParticipant[]
  organizerNgo        Ngo?                  @relation("NgoOrganizedCampaigns", fields: [organizerNgoId], references: [id])
  organizerUser       User?                 @relation("UserOrganizedCampaigns", fields: [organizerUserId], references: [id])

  @@map("campaigns")
}

model CampaignParticipant {
  id             String            @id @default(uuid())
  campaignId     String            @map("campaign_id")
  userId         String            @map("user_id")
  identityNumber String?           @map("identity_number")
  status         ParticipantStatus @default(PENDING)
  joinedAt       DateTime          @default(now()) @map("joined_at")
  code           String?
  campaign       Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@map("campaign_participants")
}


model Donation {
  id             String         @id @default(uuid())
  donorId        String?        @map("donor_id")
  recipientNgoId String?        @map("recipient_ngo_id")
  title          String?
  category       String?
  condition      String?
  pickupType     String?        @map("pickup_type")
  quantity       Int?
  personsServed  Int?           @map("persons_served")
  description    String?
  location       String?
  latitude       Float?
  longitude      Float?
  pickupAddress  String?        @map("pickup_address")
  timeFrom       DateTime?      @map("time_from")
  timeTo         DateTime?      @map("time_to")
  photos         String[]       @default([])
  status         DonationStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")
  donorNgoId     String?        @map("donor_ngo_id")
  otp            String?
  amount         Float?
  reachedDonor   Boolean        @default(false) @map("reached_donor")
  transactionId  String?        @map("transaction_id")
  donor          User?          @relation(fields: [donorId], references: [id])
  donorNgo       Ngo?           @relation("NgoMadeDonations", fields: [donorNgoId], references: [id])
  recipientNgo   Ngo?           @relation("NgoReceivedDonations", fields: [recipientNgoId], references: [id])

  @@map("donations")
}


enum AnimalStatus {
  AVAILABLE
  ADOPTED
  UNDER_TREATMENT
  RESCUED
}

enum RescueStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

enum AdoptionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CampaignStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  PENDING
  APPROVED
  REJECTED
}

enum DonationStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum PostType {
  AWARENESS
  EVENT
  ACHIEVEMENT
  URGENT
  GENERAL
}

enum LocationType {
  SHELTER
  HOSPITAL
  CAMP
  PICKUP_POINT
  GENERAL
}



model Location {
  id        String        @id @default(uuid())
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  type      LocationType?

  @@map("locations")
}

model Faq {
  id       String  @id @default(uuid())
  category String?
  question String
  answer   String

  @@map("faqs")
}

model Testimonial {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  content   String
  rating    Int?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("testimonials")
}

model Newsletter {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletters")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}

model Complaint {
  id          String   @id @default(uuid())
  reporterId  String?  @map("reporter_id")
  title       String
  description String
  targetType  String
  targetId    String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")
  reporter    User?    @relation(fields: [reporterId], references: [id])

  @@map("complaints")
}

model NgoPost {
  id          String    @id @default(uuid())
  ngoId       String    @map("ngo_id")
  postType    PostType? @map("post_type")
  title       String
  description String?
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  ngo         Ngo       @relation(fields: [ngoId], references: [id], onDelete: Cascade)

  @@map("ngo_posts")
}

model NgoReview {
  id        String   @id @default(uuid())
  ngoId     String   @map("ngo_id")
  userId    String   @map("user_id")
  content   String
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")
  ngo       Ngo      @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ngo_reviews")
}

model User {
  id                 String                @id @default(uuid())
  name               String
  email              String                @unique
  phoneNumber        String?               @map("phone_number")
  dateOfBirth        DateTime?             @map("date_of_birth") @db.Date
  location           String?
  occupation         String?
  photoUrl           String?               @map("photo_url")
  latitude           Float?
  longitude          Float?
  passwordHash       String                @map("password_hash")
  otpVerified        Boolean               @default(false) @map("otp_verified")
  createdAt          DateTime              @default(now()) @map("created_at")
  adoptions          Adoption[]
  animalsPosted      Animal[]              @relation("UserPostedAnimals")
  campaignsJoined    CampaignParticipant[]
  campaignsOrganized Campaign[]            @relation("UserOrganizedCampaigns")
  complaints         Complaint[]
  donations          Donation[]
  ngoReviews         NgoReview[]
  rescueRequests     RescueRequest[]
  testimonials       Testimonial[]

  @@map("users")
}

model Ngo {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  phoneNumber          String?         @map("phone_number")
  registrationNumber   String?         @unique @map("registration_number")
  location             String?
  latitude             Float?
  longitude            Float?
  areaOfWork           String?         @map("area_of_work")
  description          String?
  photoUrl             String?         @map("photo_url")
  passwordHash         String          @map("password_hash")
  otpVerified          Boolean         @default(false) @map("otp_verified")
  verified             Boolean         @default(false)
  createdAt            DateTime        @default(now()) @map("created_at")
  achievements         String?
  workDone             String?         @map("work_done")
  certificateUrl       String?         @map("certificate_url")
  upiId                String?         @map("upi_id")
  websiteUrl           String?         @map("website_url")
  adoptions            Adoption[]
  animalsPosted        Animal[]        @relation("NgoPostedAnimals")
  campaignsOrganized   Campaign[]      @relation("NgoOrganizedCampaigns")
  donationsMade        Donation[]      @relation("NgoMadeDonations")
  donationsReceived    Donation[]      @relation("NgoReceivedDonations")
  posts                NgoPost[]
  reviews              NgoReview[]
  rescueRequestsNearby RescueRequest[]
  reportedRescues      RescueRequest[] @relation("NgoReportedRescues")

  @@map("ngos")
}
