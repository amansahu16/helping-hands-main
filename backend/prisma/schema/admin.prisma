// ─── ADMIN MODEL ─────────────────────────────────────────────

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phoneNumber  String   @map("phone_number")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}
