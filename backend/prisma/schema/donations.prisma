model Donation {
  id             String         @id @default(uuid())
  donorId        String?        @map("donor_id")
  recipientNgoId String?        @map("recipient_ngo_id")
  title          String?
  category       String?
  condition      String?
  pickupType     String?        @map("pickup_type")
  quantity       Int?
  personsServed  Int?           @map("persons_served")
  description    String?
  location       String?
  latitude       Float?
  longitude      Float?
  pickupAddress  String?        @map("pickup_address")
  timeFrom       DateTime?      @map("time_from")
  timeTo         DateTime?      @map("time_to")
  photos         String[]       @default([])
  status         DonationStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")
  donorNgoId     String?        @map("donor_ngo_id")
  otp            String?
  amount         Float?
  reachedDonor   Boolean        @default(false) @map("reached_donor")
  transactionId  String?        @map("transaction_id")
  items          DonationItem[]
  donor          User?          @relation(fields: [donorId], references: [id])
  donorNgo       Ngo?           @relation("NgoMadeDonations", fields: [donorNgoId], references: [id])
  recipientNgo   Ngo?           @relation("NgoReceivedDonations", fields: [recipientNgoId], references: [id])

  @@map("donations")
}

model DonationItem {
  id          String   @id @default(uuid())
  donationId  String   @map("donation_id")
  itemType    String?  @map("item_type")
  description String?
  quantity    Int?
  donation    Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@map("donation_items")
}
