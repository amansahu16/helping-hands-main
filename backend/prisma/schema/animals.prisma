model Animal {
  id             String       @id @default(uuid())
  postedByUserId String?      @map("posted_by_user_id")
  postedByNgoId  String?      @map("posted_by_ngo_id")
  name           String?
  category       String?
  age            String?
  location       String?
  latitude       Float?
  longitude      Float?
  description    String?
  photos         String[]     @default([])
  status         AnimalStatus @default(AVAILABLE)
  createdAt      DateTime     @default(now()) @map("created_at")
  adoptions      Adoption[]
  postedByNgo    Ngo?         @relation("NgoPostedAnimals", fields: [postedByNgoId], references: [id])
  postedByUser   User?        @relation("UserPostedAnimals", fields: [postedByUserId], references: [id])

  @@map("animals")
}

model Adoption {
  id        String         @id @default(uuid())
  animalId  String         @map("animal_id")
  adopterId String?        @map("adopter_id")
  ngoId     String?        @map("ngo_id")
  status    AdoptionStatus @default(IN_PROGRESS)
  createdAt DateTime       @default(now()) @map("created_at")
  adoptedAt DateTime?      @map("adopted_at")
  adopter   User?          @relation(fields: [adopterId], references: [id])
  animal    Animal         @relation(fields: [animalId], references: [id], onDelete: Cascade)
  ngo       Ngo?           @relation(fields: [ngoId], references: [id])

  @@map("adoptions")
}

model RescueRequest {
  id             String       @id @default(uuid())
  reporterId     String?      @map("reporter_id")
  nearbyCenterId String?      @map("nearby_center_id")
  animalType     String?      @map("animal_type")
  location       String?
  latitude       Float?
  longitude      Float?
  description    String?
  condition      String?
  photos         String[]     @default([])
  nearbyHospital String?      @map("nearby_hospital")
  status         RescueStatus @default(OPEN)
  createdAt      DateTime     @default(now()) @map("created_at")
  nearbyCenter   Ngo?         @relation("NgoClaimedRescues", fields: [nearbyCenterId], references: [id])
  reporter       User?        @relation(fields: [reporterId], references: [id])
  reporterNgoId  String?      @map("reporter_ngo_id")
  reporterNgo    Ngo?         @relation("NgoReportedRescues", fields: [reporterNgoId], references: [id])

  @@map("rescue_requests")
}
