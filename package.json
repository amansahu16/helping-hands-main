{
  "name": "helping-hands-workspace",
  "version": "1.0.0",
  "description": "Helping Hands Platform Workspace",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "multer": "^2.1.1",
    "resend": "^6.12.4"
  }
}
